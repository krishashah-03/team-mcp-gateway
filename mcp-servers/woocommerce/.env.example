WOOCOMMERCE_BASE_URL=https://your-store.local
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret

# Local development with a private CA only; leave unset in production.
# WOOCOMMERCE_CA_BUNDLE=C:\path\to\store.crt

# Shared secret the gateway sends as "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=change_me
MCP_PORT=8001
