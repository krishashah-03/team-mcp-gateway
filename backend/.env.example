# Use 127.0.0.1, not localhost: on Windows localhost resolves to IPv6 first and hangs.
# Port 5433 is the host port published by compose.yaml.
DATABASE_URL=postgresql+psycopg://mcp_app:change_me@127.0.0.1:5433/team_mcp_gateway

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_value_of_at_least_32_chars
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change_me

# First admin, created at startup only if no users exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_please

# Registers the WooCommerce MCP server as the first upstream.
SEED_WOOCOMMERCE_URL=http://127.0.0.1:8001/mcp
SEED_WOOCOMMERCE_TOKEN=same_value_as_MCP_AUTH_TOKEN_of_the_woocommerce_server
