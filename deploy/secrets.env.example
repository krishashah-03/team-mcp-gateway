# Copy to deploy/secrets.env (git-ignored), fill in the values, then run:
#   kubectl create secret generic team-mcp-gateway-secrets --from-env-file=deploy/secrets.env
# (or deploy/scripts/create-secret.ps1, which also generates the random values for you).
# The Helm chart only references this Secret; no value is ever stored in the chart.

POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# One random secret per MCP server: python -c "import secrets; print(secrets.token_urlsafe(24))"
WOOCOMMERCE_MCP_TOKEN=
UTILITIES_MCP_TOKEN=
DOCS_MCP_TOKEN=

# WooCommerce REST API key (WooCommerce > Settings > Advanced > REST API, Read/Write)
WOOCOMMERCE_CONSUMER_KEY=ck_
WOOCOMMERCE_CONSUMER_SECRET=cs_

# First admin, created only when no users exist yet (password: at least 10 characters)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: enables the chat agent. OpenRouter is used when set; otherwise Gemini.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional: lets Prometheus scrape /metrics
# METRICS_TOKEN=

# Only with postgres.enabled=false (external database), instead of POSTGRES_PASSWORD:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
